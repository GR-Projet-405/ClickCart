# Local development only. Replace placeholders before using integrations.
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=clickcart
SERVER_PORT=8080
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-bytes
CLICKCART_JWT_TTL=900
CLICKCART_SECURITY_ENABLED=false
JWT_ISSUER_URI=
JWT_AUDIENCE=clickcart
CORS_ALLOWED_ORIGINS=http://localhost:5173
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
ATTACHMENTS_DIR=./data/attachments
CLICKCART_PROOF_DIR=./data/proofs
MAIL_USERNAME=
MAIL_PASSWORD=
# HTTPS email delivery (required by application-render.yml).
# Set CLICKCART_MAIL_PROVIDER=brevo to test this transport locally.
CLICKCART_MAIL_PROVIDER=smtp
BREVO_API_KEY=
MAIL_FROM=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GEMINI_API_KEY=
