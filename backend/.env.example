# Copy to backend/.env and fill in real values. Never commit backend/.env.
# Loaded automatically on startup (spring-dotenv / spring.config.import).

# Must include the database name (/clickcart), otherwise the backend does not start.
MONGODB_URI=mongodb://localhost:27017/clickcart
SERVER_PORT=8080

# --- DEV-01 Authentication (see docs/authentication.md) ---
# Required outside local dev: at least 32 random bytes, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_SESSION_TTL_HOURS=24
AUTH_REMEMBER_ME_TTL_DAYS=30
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_ENABLED=true

# true in production (HTTPS only)
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Lets requests without a token act as the old dev identity (dev-provider-09).
# Must be false in any shared or production environment.
CLICKCART_DEV_AUTH_FALLBACK=true
